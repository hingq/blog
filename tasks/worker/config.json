{
  "jobs": [
    {
      "name": "leetcode_daily",
      "enabled": true,
      "cron": "0 8 * * *",
      "command": "node",
      "args": ["leetcode-daily.cjs"],
      "cwd": ".",
      "env": {},
      "timeoutMs": 300000
    },
    {
      "name": "fetch_daily_info",
      "enabled": true,
      "cron": "30 8 * * *",
      "command": "node",
      "args": ["fetch-daily-info.cjs"],
      "cwd": ".",
      "env": {},
      "timeoutMs": 300000
    }
  ]
}
