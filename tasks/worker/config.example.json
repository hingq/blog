{
  "jobs": [
    {
      "name": "leetcode_daily",
      "enabled": true,
      "cron": "0 8 * * *",
      "command": "node",
      "args": ["dist/index.js"],
      "cwd": "tasks/leetcode-daily",
      "env": {},
      "timeoutMs": 300000
    },
    {
      "name": "fetch_daily_info",
      "enabled": false,
      "cron": "30 8 * * *",
      "command": "node",
      "args": ["dist/index.js"],
      "cwd": "tasks/fetch-daily-info",
      "env": {},
      "timeoutMs": 300000
    }
  ]
}
